[Unit]
Description=Netlanvas LCD Hardware Monitor
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/appdata/netlanvas/lcd_splash.py
WorkingDirectory=/opt/appdata/netlanvas
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
