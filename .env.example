# Copy this file to .env and adjust only if the defaults collide with
# something else on this host (see docker-compose networks: section).
# .env is already gitignored — real values for THIS host stay local.
#
# If `docker compose up` fails with "Pool overlaps with other one on
# this address space", another Docker network on this host already
# owns NETLANVAS_SUBNET below — pick a different /24 and retry.

NETLANVAS_SUBNET=172.28.1.0/24
REDIS_INTERNAL_IP=172.28.1.10

# NOT required for normal operation. netlanvas_core auto-detects and
# publishes the host's LAN IP via Redis at boot, and the TLS cert picks
# it up automatically -- see security/cert_manager.py and main.py's
# stage_publish_host_identity(). Only set this if you need an ADDITIONAL
# address/hostname in the cert beyond what's auto-detected (e.g. a
# custom local DNS name), by passing it through to the netlanvas_api
# service's NETLANVAS_TLS_EXTRA_SANS environment variable in
# docker-compose.yaml.
# NETLANVAS_PUBLIC_ADDR=netlanvas.local
